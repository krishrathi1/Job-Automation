# ==============================================================================
# O-Clario: Telegram Agentic Job Hunter (n8n Workflow)
# Environment Variables Template
# Copy this file to .env and configure the variables.
# ==============================================================================

# Telegram Configuration
# Your Telegram Chat ID (e.g. from @userinfobot or @raw_data_bot). 
# Note: The workflow has a built-in fallback chat ID, but this environment variable 
# can be used for dynamic/flexible configurations.
TELEGRAM_CHAT_ID=5513468743

# n8n General Configuration (For Self-Hosted instances)
# Port n8n will run on
PORT=5678

# Enforce secure settings permissions (Optional, set to false if running in simple environments)
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
